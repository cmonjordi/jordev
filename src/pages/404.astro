---
import Layout from '../layouts/Layout.astro';
---

<Layout title="No encontrado · Jordi" description="Esta página no existe." noindex>
  <main class="mx-auto flex min-h-dvh max-w-2xl flex-col justify-center px-6 py-16">
    <p class="text-sm uppercase tracking-widest text-neutral-500">Error 404</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight">Esta página no existe</h1>
    <p class="mt-4 text-neutral-600">
      <a href="/" class="underline underline-offset-4 hover:text-neutral-900">
        Volver al inicio
      </a>
    </p>
  </main>
</Layout>
